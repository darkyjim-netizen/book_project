# =============================================================================
# BookStore AI Commerce Platform - 환경 변수
# 이 파일을 .env 로 복사한 뒤 값을 수정하세요.
#   cp .env.example .env
# =============================================================================

# --- 애플리케이션 ------------------------------------------------------------
APP_NAME=BookStore AI Commerce
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1
TIMEZONE=Asia/Seoul

# --- 데이터베이스 (PostgreSQL 16+) -------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=book
DB_USER=postgres
DB_PASSWORD=1004
DB_SCHEMA=shop
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=False

# --- 보안 -------------------------------------------------------------------------
# 운영 환경에서는 반드시 변경하세요: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-key-in-production-env-file
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_MINUTES=20160
PASSWORD_MIN_LENGTH=8
LOGIN_FAIL_LIMIT=5

# --- CORS (쉼표로 구분) -----------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://localhost:8000"]

# --- 파일 업로드 -----------------------------------------------------------------
UPLOAD_DIR=team_backend/app/static/upload
MAX_UPLOAD_SIZE=10485760

# --- 쇼핑 정책 -------------------------------------------------------------------
DEFAULT_SHIP_FEE=3000
FREE_SHIP_LIMIT=20000
POINT_SAVE_RATE=0.01
ORDER_CONFIRM_DAYS=7
CART_MAX_ITEMS=100

# --- 결제(PG) --------------------------------------------------------------------
PG_PROVIDER=INICIS
PG_MID=INIpayTest
PG_API_KEY=test-api-key
PG_MOCK_MODE=True


# --- 결제(토스, 카카오 등) --------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:1004@localhost:5432/book

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256

# 결제 테스트 모드
PAYMENT_MODE=mock

# Toss Payments
TOSS_CLIENT_KEY= test_ck_c19xvctAV7qe2nNkcZCbOMu1zLMLciJcH5
TOSS_SECRET_KEY= test_sk_c19xvctA5UGSLbuAWE3opSte6HM63nmJ3b

# Kakao Pay
KAKAO_PAY_SECRET_KEY= DEVCE1D93B86B200B4D53178C3FEBA1B842A672B
KAKAO_PAY_CID= C91AD6F97C285327A5A5

# Frontend
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# 토스페이먼츠 API 주소와 결제 콜백 URL (배포 시 서버 도메인으로 변경)
TOSS_API_BASE_URL=https://api.tosspayments.com
PAYMENT_SUCCESS_URL=http://localhost:8000/api/payments/toss/success
PAYMENT_FAIL_URL=http://localhost:8000/api/payments/toss/fail



# --- AI ---------------------------------------------------------------------------
AI_MODEL_DIR=team_backend/app/ai/artifacts
CF_MIN_INTERACTIONS=2
CF_TOP_N=20
CF_NEIGHBOR_K=40
SENTIMENT_MODEL_VERSION=kosa-lr-v1
FORECAST_HORIZON_DAYS=30
CHURN_THRESHOLD_HIGH=0.7
CHURN_THRESHOLD_MID=0.4
CHURN_INACTIVE_DAYS=90

# --- 로깅 -------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
